# ─────────────────────────────────────────────────────────────────────────────
# WALIMATUL Environment Variables — Example
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Public) ────────────────────────────────────────────────────────
# These values are safe to expose to the browser.
# Find them at: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xjaclwiilmmzjiftnnob.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Site URL ──────────────────────────────────────────────────────────────────
# Development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (set in Vercel):
# NEXT_PUBLIC_SITE_URL=https://walimatul.my

# ── Supabase (Server-Only) ───────────────────────────────────────────────────
# NEVER expose these to the browser.
# Used only in Server Actions and Route Handlers.

SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Optional, for direct access) ───────────────────────────────────
# DATABASE_URL=

# ── Payment (Future) ─────────────────────────────────────────────────────────
# Only add when a payment provider is selected.
# PAYMENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# WALIMATUL Environment Variables — Example
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Public) ────────────────────────────────────────────────────────
# These values are safe to expose to the browser.
# Find them at: Supabase Dashboard → Settings → API
# NOTE: The key is named PUBLISHABLE_KEY (not ANON_KEY) since @supabase/ssr 0.6+

NEXT_PUBLIC_SUPABASE_URL=https://xjaclwiilmmzjiftnnob.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Site URL ──────────────────────────────────────────────────────────────────
# Development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (set in Vercel):
# NEXT_PUBLIC_SITE_URL=https://walimatul.my

# ── Supabase (Server-Only) ───────────────────────────────────────────────────
# NEVER expose to the browser. Used in Server Actions only.
# Find at: Supabase Dashboard → Settings → API → Service Role key

SUPABASE_SERVICE_ROLE_KEY=

# ── Payment Provider: Bayarcash (Phase 11 — do not fill yet) ─────────────────
# BAYARCASH_ACCESS_TOKEN=
# BAYARCASH_API_SECRET=
# BAYARCASH_PORTAL_KEY=
